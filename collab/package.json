{
  "name": "ncsound-collab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Collaborative mix sessions: WebSocket relay, host session, and a phone mixer remote.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/phone/main.ts --bundle --format=esm --target=es2020 --outfile=public/phone.js && esbuild src/host/demo.ts --bundle --format=esm --target=es2020 --outfile=public/host.js",
    "start": "npm run build && tsx src/server/index.ts",
    "dev": "npm run build && tsx watch src/server/index.ts",
    "test": "npm run build && tsx tests/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
