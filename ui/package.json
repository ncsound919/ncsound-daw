{
  "name": "vstaw-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NCSound DAW React frontend (WebView2) - pitch UI first, shares @chordstudio/console-ui",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-master-uplot.mjs && tsc -b && vite build",
    "check:master-uplot": "node scripts/check-master-uplot.mjs",
    "preview": "vite preview",
    "gen:routes": "node scripts/gen-native-routes.mjs",
    "check:routes": "node scripts/gen-native-routes.mjs --check",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/check-master-uplot.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/share-tech-mono": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
